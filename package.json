{
  "name": "arcane-checkers",
  "version": "1.0.0",
  "private": true,
  "description": "Arcane Checkers — checkers with collectible spell cards",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/copy-game-assets.mjs",
    "preview": "vite preview",
    "icons": "node scripts/generate-app-icons.mjs",
    "icons:android": "node scripts/generate-android-launcher-icons.mjs",
    "screenshots": "node scripts/generate-store-placeholders.mjs",
    "screenshots:auth": "npm run build && node scripts/capture-authenticated-screenshots.mjs",
    "screenshots:tablet": "npm run build && SCREENSHOT_SIZES=tablet-7,tablet-10 node scripts/capture-authenticated-screenshots.mjs",
    "screenshots:tablet:guest": "npm run build && node scripts/capture-tablet-screenshots.mjs",
    "sync:www": "sh scripts/sync-www.sh",
    "cap:sync": "npm run sync:www && npx cap sync",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "cap:ios": "npx cap open ios",
    "cap:android": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/haptics": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@capacitor/screen-orientation": "^7.0.0",
    "@capacitor/splash-screen": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0",
    "@fontsource/dm-sans": "^5.2.8",
    "@fontsource/fraunces": "^5.2.9",
    "@fontsource/sora": "^5.2.8"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "playwright": "^1.52.0",
    "sharp": "^0.34.5",
    "sirv": "^3.0.2",
    "vite": "^8.1.3",
    "vite-plugin-pwa": "^1.3.0"
  }
}
